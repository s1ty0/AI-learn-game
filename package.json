{
  "name": "learnai-workspace",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "node scripts/dev-app.mjs",
    "dev:web": "pnpm --filter @learnai/web dev",
    "build": "pnpm --filter @learnai/web build",
    "typecheck": "pnpm --filter @learnai/web typecheck",
    "test:web": "pnpm --filter @learnai/web test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:api": "node scripts/run-api-tests.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "@playwright/test": "1.65.0"
  }
}

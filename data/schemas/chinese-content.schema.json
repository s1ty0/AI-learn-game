{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chinese knowledge draft index v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "locale", "updated_on", "language_policy", "glossary", "articles"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "content_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "locale": {"const": "zh-CN"},
    "updated_on": {"type": "string", "format": "date"},
    "language_policy": {"const": "docs/language-policy.md"},
    "glossary": {"type": "array", "items": {"$ref": "#/$defs/term"}},
    "articles": {"type": "array", "items": {"$ref": "#/$defs/article"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "term": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "display_name", "first_mention", "explanation", "source_ids", "status"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/text"}, "display_name": {"$ref": "#/$defs/text"},
        "first_mention": {"$ref": "#/$defs/text"}, "explanation": {"$ref": "#/$defs/text"},
        "source_ids": {"$ref": "#/$defs/refs"}, "status": {"const": "draft"}
      }
    },
    "article": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entity_id", "title", "path", "source_ids", "locale", "status", "reviewed_by", "reviewed_on", "depth_path", "depth_source_ids", "depth_status", "open_gaps"],
      "properties": {
        "id": {"type": "string", "pattern": "^article-zh-[0-9]{3,}$"},
        "entity_id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"},
        "path": {"type": "string", "pattern": "^knowledge/zh-CN/[a-z0-9-]+\\.md$"},
        "source_ids": {"$ref": "#/$defs/refs"}, "locale": {"const": "zh-CN"}, "status": {"const": "draft"},
        "depth_path": {"type": "string", "pattern": "^knowledge/zh-CN/deep/[a-z0-9-]+\\.md$"},
        "depth_source_ids": {"$ref": "#/$defs/refs"}, "depth_status": {"const": "layered_draft"},
        "open_gaps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "reviewed_by": {"type": "null"}, "reviewed_on": {"type": "null"}
      }
    }
  }
}
